---
/**
 * "Kamu di sini" (keputusan 120): satu baris jalur Tahap › Bagian › Halaman di atas judul, plus rekap satu kalimat
 * tahap ini. Dibuat otomatis dari registry untuk setiap halaman terdaftar (dipanggil JudulHalaman.astro), jadi
 * halaman tidak perlu menulis komponen ini sendiri. Di HP hanya jalur pendek yang tampil.
 */
import { muat, label, url, urlDariId, dariUrl } from "../../tools/registri.mjs";

const d = muat();
const h = dariUrl(d, urlDariId(Astro.locals.starlightRoute.entry.id));
type Tahap = { no: number; nama: string; rekap: string; sebelumnya: string; versi?: string; bagian?: { no: number; nama: string }[] };
const t: Tahap | undefined = h && Number.isInteger(h.tahap) ? d.tahap.find((x: Tahap) => x.no === h.tahap) : undefined;
const NAMA: Record<string, string> = { pembuka: "Pembuka", sampingan: "Studi sampingan", alat: "Alat" };
const kelompok = h ? (t?.bagian?.find((b) => b.no === h.bagian)?.nama ?? h.kelompok) : undefined;
const pembuka = t ? d.halaman.find((x: { tahap: unknown; ada: boolean }) => x.tahap === t.no && x.ada) : undefined;
---
{h && (
  <nav class="kamu" aria-label="Kamu di sini">
    <ol class="kamu__jalur">
      <li><span class="kamu__tag">Kamu di sini</span></li>
      {t
        ? <li><a href={pembuka ? url(pembuka) : undefined}>Tahap {t.no}<span class="kamu__panjang"> · {t.nama}{t.versi === "lama" ? " (versi lama)" : ""}</span></a></li>
        : <li>{NAMA[h.tahap] ?? h.tahap}</li>}
      {kelompok && <li class="kamu__panjang">{kelompok}</li>}
      <li aria-current="page">{label(h, true)}</li>
    </ol>
    {t && <p class="kamu__rekap"><strong>{d.app} (fiktif).</strong> {t.rekap}</p>}
  </nav>
)}
