---
/**
 * "Kamu di sini" (keputusan 120): satu baris jalur Tahap › Bagian › Halaman di atas judul, plus rekap satu kalimat
 * tahap ini (rekap di registry sudah memuat tanda fiktif). Dibuat otomatis dari registry untuk setiap halaman terdaftar (dipanggil JudulHalaman.astro), jadi
 * halaman tidak perlu menulis komponen ini sendiri. Di HP hanya jalur pendek yang tampil.
 */
import { muat, label, url, urlDariId, dariUrl } from "../../tools/registri.mjs";

const d = muat();
const h = dariUrl(d, urlDariId(Astro.locals.starlightRoute.entry.id));
type Tahap = { no: number; nama: string; rekap: string; sebelumnya: string; versi?: string; bagian?: { no: number; nama: string }[] };
const t: Tahap | undefined = h && Number.isInteger(h.tahap) ? d.tahap.find((x: Tahap) => x.no === h.tahap) : undefined;
const NAMA: Record<string, string> = { pembuka: "Pembuka", sampingan: "Studi sampingan", alat: "Alat" };
const kelompok = h ? (t?.bagian?.find((b) => b.no === h.bagian)?.nama ?? h.kelompok) : undefined;
const pembuka = t ? d.halaman.find((x: { tahap: unknown; ada: boolean }) => x.tahap === t.no && x.ada) : undefined;
// Redesain (keputusan 202): daftar isi tersembunyi bawaan; tombol ini membukanya di semua ukuran layar.
const adaToc = (Astro.locals.starlightRoute.toc?.items?.length ?? 0) > 0;
---
{h && (
  <nav class="kamu" aria-label="Kamu di sini">
    <ol class="kamu__jalur">
      <li><span class="kamu__tag">Kamu di sini</span></li>
      {t
        ? <li><a href={pembuka ? url(pembuka) : undefined}>Tahap {t.no}<span class="kamu__panjang"> · {t.nama}{t.versi === "lama" ? " (versi lama)" : ""}</span></a></li>
        : <li>{NAMA[h.tahap] ?? h.tahap}</li>}
      {kelompok && <li class="kamu__panjang">{kelompok}</li>}
      <li aria-current="page">{label(h, true)}</li>
    </ol>
    {adaToc && (
      <button type="button" class="kamu__toc" data-toc-tombol aria-expanded="false" aria-label="Isi halaman" title="Isi halaman">
        <svg class="kamu__toc-ikon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 3.5h1.5M5.5 3.5H14M2 8h1.5M5.5 8H14M2 12.5h1.5M5.5 12.5H14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>
        <span class="kamu__toc-teks">Isi halaman</span>
      </button>
    )}
    {t && <p class="kamu__rekap">{t.rekap}</p>}
  </nav>
)}

<script>
  // Daftar isi: tersembunyi bawaan (terlihat otomatis di ≥ 1600 px). Pilihan pembaca disimpan per perangkat.
  const KUNCI = "rtj-toc";
  const html = document.documentElement;
  // Desktop (≥ 72rem): kolom kanan; HP: bilah daftar isi Starlight.
  const terlihat = () => {
    const el = document.querySelector(matchMedia("(min-width: 72rem)").matches ? ".right-sidebar-container" : "mobile-starlight-toc");
    return !!el && getComputedStyle(el).display !== "none";
  };
  const segarkan = () => document.querySelectorAll("[data-toc-tombol]").forEach((b) => b.setAttribute("aria-expanded", String(terlihat())));
  try { const s = localStorage.getItem(KUNCI); if (s) html.dataset.toc = s; } catch { /* mode privat */ }
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest("[data-toc-tombol]")) return;
    const baru = terlihat() ? "tutup" : "buka";
    html.dataset.toc = baru;
    try { localStorage.setItem(KUNCI, baru); } catch { /* mode privat */ }
    if (baru === "buka") document.querySelector<HTMLDetailsElement>("mobile-starlight-toc details")?.setAttribute("open", "");
    segarkan();
  });
  addEventListener("resize", segarkan);
  segarkan();
</script>
