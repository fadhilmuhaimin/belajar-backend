{
  "skenario": "Budi kirim Rp70.000 ke Ani. UPDATE kedua gagal karena saldo Ani melewati batas Rp1.000.000.",
  "langkah": [
    {
      "id": "begin",
      "label": "BEGIN"
    },
    {
      "id": "u1",
      "label": "UPDATE Budi −Rp70.000"
    },
    {
      "id": "u2",
      "label": "UPDATE Ani +Rp70.000 gagal"
    },
    {
      "id": "rb",
      "label": "ROLLBACK"
    }
  ],
  "stack": {
    "Go": {
      "src": "labs/b3-stack/go/main.go#transfer",
      "pola": {
        "begin": [
          "db.BeginTx"
        ],
        "u1": [
          "saldo - $1"
        ],
        "u2": [
          "saldo + $1"
        ],
        "rb": [
          "defer tx.Rollback()"
        ]
      },
      "catatan": {
        "rb": "Dipasang sekali di awal; jalan saat fungsi keluar lewat return err"
      }
    },
