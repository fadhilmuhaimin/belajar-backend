{
  "permissions": {
    "allow": [
      "Read",
      "Edit(/**)",
      "Skill",
      "Agent",
      "WebSearch",
      "WebFetch",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(labs/.venv/bin/*)",
      "Bash(./labs/.venv/bin/*)",
      "Bash(bash tools/*)",
      "Bash(bash labs/*)",
      "Bash(bash situs/*)",
      "Bash(make *)",
      "Bash(go *)",
      "Bash(docker *)",
      "Bash(gitleaks *)",
      "Bash(gosec *)",
      "Bash(curl *)",
      "Bash(lsof *)",
      "Bash(ps *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(ln *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(date *)",
      "Bash(sleep *)",
      "Bash(shasum *)",
      "Bash(du *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(gh pr merge * --admin*)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git clean*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf .git*)",
      "Bash(pkill *caffeinate*)",
      "Bash(killall *)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker image prune*)",
      "Read(./.env*)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/simpan-memori.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/baca-memori.sh"
          }
        ]
      }
    ]
  }
}