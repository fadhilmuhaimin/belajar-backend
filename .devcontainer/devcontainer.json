{
  "name": "Belajar Backend",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.27" },
    "ghcr.io/devcontainers/features/node:2": { "version": "22" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.14" },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "forwardPorts": [8000, 54333, 56379],
  "portsAttributes": {
    "8000": { "label": "mkdocs serve" },
    "54333": { "label": "PostgreSQL 17 lab" },
    "56379": { "label": "Redis 8 lab" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "dart-code.dart-code", "ms-python.python"]
    }
  }
}
